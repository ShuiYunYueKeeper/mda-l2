{
  "name": "mda",
  "version": "3.0.0",
  "description": "Markdown 工作台 — 预览 · 编辑 · 批注 · 文件管理（CLI / GUI / MCP）",
  "author": "MDA <mda.markdown@gmail.com>",
  "desktopName": "mda.desktop",
  "main": "dist/gui/main.js",
  "bin": {
    "mda": "dist/gui/launcher.js",
    "mda-cli": "dist/cli/main.js",
    "mda-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:ts": "tsc",
    "build:editor": "node scripts/generate-gui-icons.js && node scripts/bundle-editor.js",
    "watch:editor": "node scripts/bundle-editor.js --watch",
    "build:gui": "node scripts/copy-gui.js",
    "build": "npm run build:ts && npm run build:editor && npm run build:gui",
    "cli": "node dist/cli/main.js",
    "mcp": "node dist/mcp/server.js",
    "gui": "electron dist/gui/main.js",
    "start": "electron dist/gui/main.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update": "npm run build && playwright test --update-snapshots",
    "generate:gui-icons": "node scripts/generate-gui-icons.js",
    "generate:app-icon": "node scripts/generate-app-icon.js",
    "coverage": "jest --coverage",
    "dist": "npm run build && node scripts/ensure-no-bom.js && node scripts/pre-dist.js && electron-builder && node scripts/verify-release.js",
    "dist:win": "npm run build && node scripts/ensure-no-bom.js && node scripts/pre-dist.js && electron-builder --win && node scripts/verify-release.js",
    "dist:mac": "npm run build && node scripts/ensure-no-bom.js && electron-builder --mac",
    "dist:linux": "npm run build && node scripts/ensure-no-bom.js && electron-builder --linux",
    "skill:sync": "node scripts/sync-l2-skill.js",
    "skill:install": "node scripts/sync-l2-skill.js && node scripts/install-l2-skill.js",
    "skill:install:project": "node scripts/sync-l2-skill.js && node scripts/install-l2-skill.js --project"
  },
  "keywords": [
    "markdown",
    "annotation",
    "comment",
    "review"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShuiYunYueKeeper/mda-l2.git"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.2",
    "@lezer/markdown": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "commander": "^12.1.0",
    "electron": "^31.7.7",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "html-to-docx": "^1.8.0",
    "katex": "^0.17.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.16.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jest": "^29.5.12",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "c8": "^10.1.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "lucide": "^1.31.0",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "ts-jest": "^29.4.11",
    "typescript": "^5.5.3"
  },
  "copyright": "Copyright © 2026 MDA",
  "build": {
    "appId": "com.mda.annotation-tool",
    "productName": "MDA",
    "icon": "src/gui/icon.png",
    "copyright": "Copyright © 2026 MDA",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "mdc",
        "name": "Markdown Cursor Rules",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "src/gui/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${os}-${arch}.${ext}",
      "useZip": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MDA",
      "unicode": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "MDA <mda.markdown@gmail.com>",
      "syncDesktopName": true,
      "synopsis": "Markdown 工作台 — 预览 · 编辑 · 批注 · 文件管理",
      "description": "本地优先的 Markdown 工作台，支持预览、编辑、结构化批注、导出，以及 CLI / MCP 入口。"
    },
    "publish": {
      "provider": "github",
      "owner": "ShuiYunYueKeeper",
      "repo": "mda-l2",
      "releaseType": "prerelease"
    }
  }
}
